{
  "name": "repo-start",
  "version": "0.2.0",
  "description": "Create the boring foundational files of a new repository, correctly.",
  "keywords": [
    "cli",
    "scaffold",
    "boilerplate",
    "repository",
    "generator"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "repo-start": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"tests/*.test.ts\"",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
